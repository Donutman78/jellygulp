JELLYFIN_URL=http://REPLACE_WITH_YOUR_JELLYFIN_LAN_IP:PORT
JELLYFIN_API_KEY=REPLACE_WITH_YOUR_PRIVATE_API_KEY
DATABASE_URL=postgresql+psycopg://jellygulp:CHANGE_ME@database:5432/jellygulp
POSTGRES_DB=jellygulp
POSTGRES_USER=jellygulp
POSTGRES_PASSWORD=CHANGE_ME
POLL_INTERVAL_SECONDS=10
CORS_ORIGINS=*
# Comma-separated Jellyfin library names to exclude from movie/series/episode counts
# (e.g. preroll or intro libraries that Jellyfin types as "Movies" but aren't real content)
EXCLUDED_LIBRARY_NAMES=Prerolls
